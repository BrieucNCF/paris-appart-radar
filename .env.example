# =========================================================================
# Paris Appart Radar — variables d'environnement (modèle)
# Copie ce fichier en `.env` et remplis les valeurs. Ne commit JAMAIS `.env`.
# =========================================================================

# --- Supabase (Phase 1) ---------------------------------------------------
# Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=            # clé publique (carte, lecture seule)
SUPABASE_SERVICE_ROLE_KEY=    # clé secrète (Edge Function / ingestion) — NE JAMAIS exposer côté web

# --- Telegram (Phase 2) ---------------------------------------------------
TELEGRAM_BOT_TOKEN=           # donné par @BotFather
TELEGRAM_CHAT_ID=             # ton chat id (ou celui du groupe)

# --- Gmail API (Phase 3) --------------------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_LABEL=paris-appart      # libellé Gmail où arrivent les alertes

# --- Divers ---------------------------------------------------------------
# api-adresse.data.gouv.fr ne nécessite aucune clé.
