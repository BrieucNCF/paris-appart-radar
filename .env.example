# =========================================================================
# Paris Appart Radar — variables d'environnement (modèle)
# Copie ce fichier en `.env` et remplis les valeurs. Ne commit JAMAIS `.env`.
# =========================================================================

# --- Supabase (Phase 1) ---------------------------------------------------
# Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=            # clé publique (carte, lecture seule)
SUPABASE_SERVICE_ROLE_KEY=    # clé secrète (Edge Function / ingestion) — NE JAMAIS exposer côté web

# --- Telegram (Phase 2) ---------------------------------------------------
TELEGRAM_BOT_TOKEN=           # donné par @BotFather
TELEGRAM_CHAT_ID=             # ton chat id (ou celui du groupe)

# --- Gmail via IMAP (Phase 3) ---------------------------------------------
GMAIL_USER=                   # ton adresse Gmail (ex. prenom@gmail.com)
GMAIL_APP_PASSWORD=           # mot de passe d'application 16 caractères (PAS ton mdp Gmail)
GMAIL_LABEL=paris-appart      # libellé Gmail où le filtre range les alertes PAP

# --- Divers ---------------------------------------------------------------
# api-adresse.data.gouv.fr ne nécessite aucune clé.

# --- Carte (Phase 6) ---
MAP_URL=            # ex. https://ton-user.github.io/paris-appart-radar (rempli en Phase 6)
